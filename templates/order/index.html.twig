{% extends 'base.html.twig' %}

{% block title %}Mes commandes - MiniShop{% endblock %}

{% block body %}
<div class="container py-5">
    <h1><i class="bi bi-bag"></i> Mes commandes</h1>
    <hr>

    {% if orders|length == 0 %}
        <div class="text-center py-5">
            <i class="bi bi-bag-x" style="font-size: 4rem; color: #6c757d;"></i>
            <h3 class="mt-3">Aucune commande</h3>
            <p class="text-muted">Vous n'avez pas encore passé de commande.</p>
            <a href="{{ path('app_product_index') }}" class="btn btn-primary">
                <i class="bi bi-grid"></i> Voir les produits
            </a>
        </div>
    {% else %}
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Référence</th>
                        <th>Date</th>
                        <th>Nombre d'articles</th>
                        <th>Total</th>
                        <th>Statut</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for order in orders %}
                        <tr>
                            <td><strong>{{ order.reference }}</strong></td>
                            <td>{{ order.createdAt|date('d/m/Y H:i') }}</td>
                            <td>{{ order.items|length }}</td>
                            <td class="fw-bold">{{ order.totalAmount }} &euro;</td>
                            <td>
                                <span class="badge {{ order.statusBadgeClass }}">{{ order.statusLabel }}</span>
                            </td>
                            <td>
                                <a href="{{ path('app_order_show', {id: order.id}) }}" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye"></i> Détails
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>
{% endblock %}
