<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Mini E-Commerce{% endblock %}</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Bootstrap & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        :root {
            --primary-color: #6366f1; /* Indigo */
            --primary-hover: #4f46e5;
            --bg-color: #f3f4f6;
            --text-main: #1f2937;
        }
        body { 
            font-family: 'Poppins', sans-serif;
            color: var(--text-main);
            background-color: var(--bg-color);
            min-height: 100vh; 
            display: flex; 
            flex-direction: column; 
        }
        main { flex: 1; }
        
        /* Navbar */
        .navbar {
            background-color: #ffffff !important;
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
            padding: 15px 0;
        }
        .navbar-brand { font-weight: 700; color: var(--primary-color) !important; font-size: 1.5rem; letter-spacing: -0.5px; }
        .nav-link { font-weight: 500; transition: color 0.3s; color: #4b5563 !important; }
        .nav-link:hover { color: var(--primary-color) !important; }
        .badge-cart { position: relative; top: -8px; font-size: 0.7rem; background-color: #ef4444 !important; }
        
        /* Buttons */
        .btn { font-weight: 500; border-radius: 8px; transition: all 0.2s; }
        .btn-primary { background-color: var(--primary-color); border-color: var(--primary-color); }
        .btn-primary:hover { background-color: var(--primary-hover); border-color: var(--primary-hover); transform: translateY(-1px); box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3); }
        .btn-outline-primary { color: var(--primary-color); border-color: var(--primary-color); }
        .btn-outline-primary:hover { background-color: var(--primary-color); color: white; }
        
        /* Cards */
        .card { border: none; border-radius: 16px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); transition: all 0.3s ease; overflow: hidden; }
        .product-card:hover { transform: translateY(-8px); box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1), 0 10px 10px -5px rgba(0,0,0,0.04); }
        .card-header { background-color: white; border-bottom: 1px solid rgba(0,0,0,0.05); font-weight: 600; padding: 1rem 1.5rem; }
        
        /* Hero Section */
        .hero-section { 
            background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%); 
            color: white; 
            padding: 100px 0; 
            border-radius: 0 0 40px 40px;
            margin-bottom: 50px;
            box-shadow: 0 10px 30px rgba(99, 102, 241, 0.2);
        }
        
        /* Footer */
        footer { background-color: #ffffff; border-top: 1px solid #e5e7eb; color: #6b7280; padding: 2rem 0; }
        
        /* Utilities */
        .rounded-custom { border-radius: 16px !important; }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body>
    {# Navbar #}
    <nav class="navbar navbar-expand-lg sticky-top">
        <div class="container">
            <a class="navbar-brand" href="{{ path('app_home') }}">
                <i class="bi bi-bag-heart-fill me-2"></i>MiniShop
            </a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto ps-3">
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_home') }}">Accueil</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_product_index') }}">Produits</a>
                    </li>
                </ul>
                <ul class="navbar-nav align-items-center">
                    <li class="nav-item me-3">
                        <a class="nav-link position-relative" href="{{ path('app_cart_index') }}">
                            <i class="bi bi-cart3 fs-5"></i> Panier
                            {% if cart_count > 0 %}
                                <span class="badge badge-cart rounded-pill">{{ cart_count }}</span>
                            {% endif %}
                        </a>
                    </li>
                    {% if app.user %}
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle fs-5 me-1"></i> {{ app.user.firstName }}
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end border-0 shadow rounded-custom mt-2">
                                <li><a class="dropdown-item py-2" href="{{ path('app_order_index') }}"><i class="bi bi-box-seam me-2 text-primary"></i> Mes commandes</a></li>
                                {% if is_granted('ROLE_ADMIN') %}
                                    <li><a class="dropdown-item py-2" href="{{ path('admin') }}"><i class="bi bi-gear-fill me-2 text-primary"></i> Administration</a></li>
                                {% endif %}
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item py-2 text-danger" href="{{ path('app_logout') }}"><i class="bi bi-box-arrow-right me-2"></i> Déconnexion</a></li>
                            </ul>
                        </li>
                    {% else %}
                        <li class="nav-item">
                            <a class="btn btn-outline-primary px-4 me-2" href="{{ path('app_login') }}">Connexion</a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-primary px-4" href="{{ path('app_register') }}">Inscription</a>
                        </li>
                    {% endif %}
                </ul>
            </div>
        </div>
    </nav>

    {# Flash Messages #}
    <div class="container mt-4">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show border-0 shadow-sm rounded-3" role="alert">
                    <i class="bi bi-info-circle-fill me-2"></i> {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}
        {% endfor %}
    </div>

    {# Main Content #}
    <main>
        {% block body %}{% endblock %}
    </main>

    {# Footer #}
    <footer class="mt-auto">
        <div class="container text-center">
            <p class="mb-0 fw-medium">&copy; {{ "now"|date("Y") }} MiniShop. Fait avec <i class="bi bi-heart-fill text-danger mx-1"></i> et Symfony.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    {% block javascripts %}{% endblock %}
</body>
</html>
