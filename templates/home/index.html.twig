{% extends 'base.html.twig' %}

{% block title %}Accueil - MiniShop{% endblock %}

{% block body %}
    {# Hero Section #}
    <section class="hero-section text-center">
        <div class="container">
            <h1 class="display-4 fw-bold mb-3">Bienvenue sur MiniShop</h1>
            <p class="lead mb-4">Découvrez notre sélection de produits de qualité</p>
            <a href="{{ path('app_product_index') }}" class="btn btn-light btn-lg">
                <i class="bi bi-grid"></i> Voir tous les produits
            </a>
        </div>
    </section>

    {# Categories #}
    {% if categories|length > 0 %}
    <section class="py-5 bg-light">
        <div class="container">
            <h2 class="text-center mb-4">Nos Catégories</h2>
            <div class="row g-4">
                {% for category in categories %}
                    <div class="col-md-4 col-lg-3">
                        <a href="{{ path('app_product_category', {slug: category.slug}) }}" class="text-decoration-none">
                            <div class="card h-100 text-center product-card">
                                <div class="card-body">
                                    <i class="bi bi-tag fs-1 text-primary"></i>
                                    <h5 class="card-title mt-2">{{ category.name }}</h5>
                                    <p class="text-muted small">{{ category.products|length }} produit(s)</p>
                                </div>
                            </div>
                        </a>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>
    {% endif %}

    {# Featured Products #}
    {% if featured_products|length > 0 %}
    <section class="py-5">
        <div class="container">
            <h2 class="text-center mb-4">Produits Récents</h2>
            <div class="row g-4">
                {% for product in featured_products %}
                    <div class="col-md-6 col-lg-3">
                        <div class="card h-100 product-card">
                            <div class="card-body d-flex flex-column">
                                <div class="text-center mb-3">
                                    <i class="bi bi-box-seam fs-1 text-muted"></i>
                                </div>
                                <h5 class="card-title">{{ product.name }}</h5>
                                <p class="text-muted small">{{ product.category.name }}</p>
                                <p class="card-text small">{{ product.description|length > 80 ? product.description|slice(0, 80) ~ '...' : product.description }}</p>
                                <div class="mt-auto">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="fw-bold text-primary fs-5">{{ product.price }} &euro;</span>
                                        <span class="badge {{ product.stock > 0 ? 'bg-success' : 'bg-danger' }}">
                                            {{ product.stock > 0 ? 'En stock' : 'Rupture' }}
                                        </span>
                                    </div>
                                    <div class="mt-2 d-grid gap-2">
                                        <a href="{{ path('app_product_show', {slug: product.slug}) }}" class="btn btn-outline-primary btn-sm">Voir le détail</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>
    {% endif %}
{% endblock %}
