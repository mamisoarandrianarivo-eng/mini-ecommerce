{% extends 'base.html.twig' %}

{% block title %}{{ product.name }} - MiniShop{% endblock %}

{% block body %}
<div class="container py-5">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Accueil</a></li>
            <li class="breadcrumb-item"><a href="{{ path('app_product_index') }}">Produits</a></li>
            <li class="breadcrumb-item"><a href="{{ path('app_product_category', {slug: product.category.slug}) }}">{{ product.category.name }}</a></li>
            <li class="breadcrumb-item active">{{ product.name }}</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-md-5 text-center">
            <div class="card p-5">
                <i class="bi bi-box-seam" style="font-size: 8rem; color: #6c757d;"></i>
            </div>
        </div>
        <div class="col-md-7">
            <h1>{{ product.name }}</h1>
            <p class="text-muted"><i class="bi bi-tag"></i> {{ product.category.name }}</p>
            <hr>
            <p class="fs-3 fw-bold text-primary">{{ product.price }} &euro;</p>

            <p>{{ product.description }}</p>

            <div class="mb-3">
                <span class="badge {{ product.stock > 0 ? 'bg-success' : 'bg-danger' }} fs-6">
                    {{ product.stock > 0 ? 'En stock (' ~ product.stock ~ ' disponibles)' : 'Rupture de stock' }}
                </span>
            </div>

            {% if product.stock > 0 %}
                <form action="{{ path('app_cart_add', {id: product.id}) }}" method="post" class="d-flex align-items-center gap-3">
                    <div class="input-group" style="width: 150px;">
                        <span class="input-group-text">Qté</span>
                        <input type="number" name="quantity" value="1" min="1" max="{{ product.stock }}" class="form-control">
                    </div>
                    <button type="submit" class="btn btn-primary btn-lg">
                        <i class="bi bi-cart-plus"></i> Ajouter au panier
                    </button>
                </form>
            {% endif %}

            <hr>
            <p class="text-muted small">Ajouté le {{ product.createdAt|date('d/m/Y') }}</p>
        </div>
    </div>
</div>
{% endblock %}
