{% extends 'base.html.twig' %}

{% block title %}{{ current_category ? current_category.name : 'Tous les produits' }} - MiniShop{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row">
        {# Sidebar Categories #}
        <div class="col-lg-3 mb-4">
            <div class="card">
                <div class="card-header bg-dark text-white">
                    <i class="bi bi-tags"></i> Catégories
                </div>
                <div class="list-group list-group-flush">
                    <a href="{{ path('app_product_index') }}" class="list-group-item list-group-item-action {{ current_category is null ? 'active' : '' }}">
                        Toutes les catégories
                    </a>
                    {% for category in categories %}
                        <a href="{{ path('app_product_category', {slug: category.slug}) }}" class="list-group-item list-group-item-action {{ current_category and current_category.id == category.id ? 'active' : '' }}">
                            {{ category.name }}
                            <span class="badge bg-secondary float-end">{{ category.products|length }}</span>
                        </a>
                    {% endfor %}
                </div>
            </div>
        </div>

        {# Product Grid #}
        <div class="col-lg-9">
            <h2 class="mb-4">
                {% if current_category %}
                    {{ current_category.name }}
                {% else %}
                    Tous les produits
                {% endif %}
            </h2>

            {% if products|length == 0 %}
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i> Aucun produit trouvé dans cette catégorie.
                </div>
            {% else %}
                <div class="row g-4">
                    {% for product in products %}
                        <div class="col-md-6 col-xl-4">
                            <div class="card h-100 product-card">
                                <div class="card-body d-flex flex-column">
                                    <div class="text-center mb-3">
                                        <i class="bi bi-box-seam fs-1 text-muted"></i>
                                    </div>
                                    <h5 class="card-title">{{ product.name }}</h5>
                                    <p class="text-muted small mb-1"><i class="bi bi-tag"></i> {{ product.category.name }}</p>
                                    <p class="card-text small">{{ product.description|length > 100 ? product.description|slice(0, 100) ~ '...' : product.description }}</p>
                                    <div class="mt-auto">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <span class="fw-bold text-primary fs-5">{{ product.price }} &euro;</span>
                                            <span class="badge {{ product.stock > 0 ? 'bg-success' : 'bg-danger' }}">
                                                {{ product.stock > 0 ? 'En stock (' ~ product.stock ~ ')' : 'Rupture' }}
                                            </span>
                                        </div>
                                        <div class="d-grid gap-2">
                                            <a href="{{ path('app_product_show', {slug: product.slug}) }}" class="btn btn-outline-primary btn-sm">
                                                <i class="bi bi-eye"></i> Voir le détail
                                            </a>
                                            {% if product.stock > 0 %}
                                                <form action="{{ path('app_cart_add', {id: product.id}) }}" method="post">
                                                    <input type="hidden" name="quantity" value="1">
                                                    <button type="submit" class="btn btn-primary btn-sm w-100">
                                                        <i class="bi bi-cart-plus"></i> Ajouter au panier
                                                    </button>
                                                </form>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
